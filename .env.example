# Copy this file to `.env` in the project root (same folder as manage.py)
# and fill in real values there. `.env` is already excluded by .gitignore —
# never commit it, and never put a real secret in this .env.example file.

# ── AI Chat / AI Review (scheduler/ai/) ─────────────────────────────────────
# Leave AI_PROVIDER unset (or anything other than "openai") to keep AI Chat
# in its "not configured" state — every deterministic ScheduleIQ feature
# works fully without this.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional — defaults shown:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Django (optional — sensible defaults exist for local development) ──────
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=*
